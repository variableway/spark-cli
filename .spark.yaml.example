# Spark CLI Configuration File
# Copy this file to ~/.spark.yaml and customize as needed

# =============================================================================
# Git Repository Paths
# =============================================================================
# Paths to scan for git repositories (used by update, create, gitcode commands)
# Can be a single path or a list of paths
repo-path:
  - ~/workspace
  - ~/projects
  - ./repos

# =============================================================================
# Git Configuration
# =============================================================================
# Default Git user configuration (used by git config command)
git:
  username: your-name
  email: your-email@example.com

# =============================================================================
# GitLab
# =============================================================================
# Personal Access Token for private/self-hosted GitLab (used by git batch-clone).
# Needs the read_api scope, plus read_repository to clone private repositories.
# Can also be provided via --token or the GITLAB_TOKEN env var.
gitlab:
  # Optional: scope the token (and GITLAB_TOKEN env vars) to this instance.
  # Credentials are then only sent to this host, e.g. gitlab.com is queried
  # anonymously instead of receiving a token meant for a self-hosted instance.
  host: gitlab.example.com
  token: glpat-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Task Management
# =============================================================================
# Task directory containing all task templates
task_dir: ~/tasks

# GitHub owner/username for creating repositories (used by task dispatch)
github_owner: your-github-username

# Working directory for dispatched tasks
work_dir: ~/workspace

# =============================================================================
# General Settings
# =============================================================================
# Default path for operations
path: .

# Default branch name for new repositories
default_branch: main

# Auto-commit changes (for supported commands)
auto_commit: true

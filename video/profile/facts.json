{
  "_note": "画面上出现的每个事实 → 它的来源和校验方式。facts.py 真跑一遍比对，编造的事实渲染前就被拦住。",
  "_schema": {
    "on_screen": "画面上出现的内容（给人和体检报告看）",
    "check": {
      "command": "跑这个命令，输出里必须包含 expect_all 里的每一串",
      "file": "读这个文件（相对仓库根），内容里必须包含 expect 里的每一串",
      "manual": "机器核不了，必须人工确认；reason 里写清为什么核不了"
    }
  },

  "facts": [
    {
      "id": "version",
      "on_screen": "v0.4.0 / commit 745cd48 / build 2026-11-15",
      "where": "S03 版本卡",
      "check": {
        "type": "command",
        "command": ["version"],
        "expect_all": ["spark v0.4.0", "commit:     745cd48", "build date: 2026-11-15T10:40:20Z"]
      }
    },
    {
      "id": "capabilities",
      "on_screen": "批量更新仓库 / 初始化仓库与远程 / 本地仓库加成子模块 / 执行自定义脚本",
      "where": "S02 四条能力编号标注",
      "check": {
        "type": "command",
        "command": ["--help"],
        "expect_all": [
          "1. Update multiple git repositories to the latest version",
          "2. Initialize a git repo and create a GitHub remote",
          "3. Add local repos or URLs as submodules",
          "4. Execute custom scripts for automation"
        ]
      }
    },
    {
      "id": "command_families",
      "on_screen": "十个命令族：git/repo/hub/skill/script/magic/docs/witr/version/completion",
      "where": "S05 架构图",
      "check": {
        "type": "command",
        "command": ["--help"],
        "expect_all": [
          "Available Commands:",
          "  completion", "  docs", "  git", "  hub",
          "  magic", "  repo", "  script", "  skill", "  witr", "  version"
        ]
      }
    },
    {
      "id": "command_tree_depth",
      "on_screen": "「一棵命令树，十个命令族」",
      "where": "S02 树标注",
      "check": {
        "type": "command",
        "command": ["--help"],
        "expect_all": ["Available Commands:"]
      }
    },
    {
      "id": "site_url",
      "on_screen": "variableway.github.io/spark-cli",
      "where": "S06 落版",
      "check": {
        "type": "file",
        "path": "docmd.config.js",
        "expect_all": ["https://variableway.github.io/spark-cli"]
      }
    },
    {
      "id": "repo_url",
      "on_screen": "github.com/variableway/spark-cli",
      "where": "S06 落版",
      "check": {
        "type": "command",
        "command": ["git", "remote", "get-url", "origin"],
        "binary": false,
        "expect_all": ["variableway/spark-cli"],
        "cwd": "repo"
      }
    },
    {
      "id": "install",
      "on_screen": "make build → ~/.local/bin/spark",
      "where": "S06 落版",
      "check": {
        "type": "file",
        "path": "README.md",
        "expect_all": ["make build", "~/.local/bin/spark"]
      }
    },
    {
      "id": "config_file",
      "on_screen": "~/.spark.yaml",
      "where": "S05 架构图配置条",
      "check": {
        "type": "file",
        "path": "README.md",
        "expect_all": ["~/.spark.yaml"]
      }
    },
    {
      "id": "quick_commands",
      "on_screen": "spark git update / spark repo scan / spark skill list / spark script run hello / spark witr nginx",
      "where": "S06 速查卡",
      "check": {
        "type": "quick_commands",
        "note": "逐条跑子命令的 --help，确认命令真的存在"
      }
    },
    {
      "id": "skill_count",
      "on_screen": "（画面里没有出现技能条数）",
      "where": "—",
      "check": {
        "type": "manual",
        "reason": "技能条数随本机环境变（装了哪些 skill 就多少个），写进片子会变成一条随时会过期的事实，所以故意不写"
      }
    }
  ]
}
